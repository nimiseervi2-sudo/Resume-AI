# Copy this file to .env and fill it in:  cp .env.example .env
# Never commit .env. It is listed in .gitignore.

# Web server
PORT=5500
# Use 0.0.0.0 only on a hosting service
HOST=127.0.0.1
# Set to 1 only on a hosting service that sits behind a proxy (such as Render)
TRUST_PROXY=

# AI service (any OpenAI-compatible API). Choose ONE option.

# Option 1: Ollama, free and private, runs on your own computer. No key needed.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=
# "none" turns off long "thinking" in reasoning models, which makes replies faster
LLM_REASONING_EFFORT=none

# Option 2: Groq (hosted). Create a key at https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=your-groq-key-here
# LLM_REASONING_EFFORT=

# Option 3: Google Gemini (hosted). Create a key at https://aistudio.google.com
# Use a model name that your account lists as free.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=your-gemini-model-name
# LLM_API_KEY=your-gemini-key-here
# LLM_REASONING_EFFORT=

# Longest wait for an AI reply, in milliseconds
LLM_TIMEOUT_MS=120000
